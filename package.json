{
  "name": "daily-workspace",
  "version": "1.8.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm --prefix web run dev --",
    "build": "npm --prefix web run build",
